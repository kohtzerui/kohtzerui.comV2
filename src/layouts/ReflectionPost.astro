---
import BaseLayout from './BaseLayout.astro';

const { post } = Astro.props;
const { title, description, publishedAt, tags } = post.data;
const date = publishedAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---
<BaseLayout title={title} description={description} current="reflections">
  <main class="wrap reflection-page">
    <header class="article-head reveal reflection-head">
      <p class="article-kicker"><a href="/reflections/">&larr; All reflections</a><span>&bull;</span><time datetime={publishedAt.toISOString()}>{date}</time></p>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      {tags.length > 0 && <div class="desk-tags">{tags.map((tag: string) => <span>{tag}</span>)}</div>}
    </header>
    <article class="reflection-prose">
      <slot />
    </article>
  </main>
</BaseLayout>