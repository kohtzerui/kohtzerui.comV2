---
import BaseLayout from './BaseLayout.astro';

const { project } = Astro.props;
const { title, description, year, publishedAt, status, tags, url, format } = project.data;
const date = publishedAt
  ? publishedAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
  : String(year);
const isCornell = format === 'cornell';
---
<BaseLayout title={title} description={description} current="side-projects">
  <main class:list={['wrap', { 'reflection-page': !isCornell }]}>
    <header class="article-head reveal reflection-head">
      <p class="article-kicker"><a href="/side-projects/">&larr; All side projects</a><span>&bull;</span><span>{status}</span><span>&bull;</span><span>{date}</span></p>
      <h1>{title}</h1>
      <p class="article-deck">{description}</p>
      <div class="project-detail-actions">
        {tags.length > 0 && <div class="desk-tags">{tags.map((tag: string) => <span>{tag}</span>)}</div>}
        {url && <a class="button button-dark" href={url} target="_blank" rel="noreferrer">Visit project <span aria-hidden="true">&nearr;</span></a>}
      </div>
      {isCornell && <div class="cornell-key"><span>Cue / visual anchor</span><span>Main notes / key thinking</span></div>}
    </header>
    <article class:list={{ 'cornell-sheet': isCornell, 'reflection-prose': !isCornell }}>
      <slot />
    </article>
  </main>
</BaseLayout>