---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [blogPosts, reflections, sideProjects, portfolioEntries, researchEntries] = await Promise.all([
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('reflections', ({ data }) => !data.draft),
  getCollection('sideProjects', ({ data }) => !data.draft),
  getCollection('portfolio', ({ data }) => !data.draft),
  getCollection('research', ({ data }) => !data.draft),
]);

const recentItems = [
  ...blogPosts.map((entry) => ({
    title: entry.data.title,
    href: `/blog/${entry.id}/`,
    category: 'Blog',
    publishedAt: entry.data.publishedAt,
  })),
  ...reflections.map((entry) => ({
    title: entry.data.title,
    href: `/reflections/${entry.id}/`,
    category: 'Reflection',
    publishedAt: entry.data.publishedAt,
  })),
  ...sideProjects.map((entry) => ({
    title: entry.data.title,
    href: `/side-projects/${entry.id}/`,
    category: 'Side project',
    publishedAt: entry.data.publishedAt ?? new Date(Date.UTC(entry.data.year, 0, 1)),
  })),
  ...portfolioEntries.map((entry) => ({
    title: entry.data.title,
    href: `/portfolio/${entry.id}/`,
    category: 'Portfolio',
    publishedAt: entry.data.publishedAt,
  })),
  ...researchEntries.map((entry) => ({
    title: entry.data.title,
    href: `/research/${entry.id}/`,
    category: 'Research',
    publishedAt: entry.data.publishedAt,
  })),
]
  .sort((a, b) => b.publishedAt.valueOf() - a.publishedAt.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<BaseLayout title="Home" description="A quiet portfolio for research, writing, and work in progress.">
  <main>
    <section class="hero wrap">
      <div class="hero-copy reveal">
        <p class="eyebrow">Researcher &middot; Builder &middot; Note-taker</p>
        <h1>I make difficult ideas <em>easier to see.</em></h1>
        <p class="hero-lede">A calm corner of the internet for field notes, careful experiments, and things I have learned by building.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="/blog/">Read the notes <span aria-hidden="true">-&gt;</span></a>
          <a class="text-link" href="/portfolio/">Explore selected work <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>

      <aside class="desk-card reveal delay-1" aria-label="Currently exploring">
        <div class="desk-card-top"><span>DESK NOTE / 01</span><span class="status-dot">LIVE</span></div>
        <p class="handwritten">&ldquo;Understanding begins when we give an idea somewhere to land.&rdquo;</p>
        <div class="latency-note" role="img" aria-label="Jeff Dean magic numbers comparing computer latency to human time">
          <div class="latency-note-title">Jeff Dean&rsquo;s magic numbers</div>
          <div class="latency-row">
            <span>L1 cache reference</span>
            <strong>~0.5-1 ns</strong>
            <em>1 second</em>
          </div>
          <div class="latency-row">
            <span>Mutex lock/unlock</span>
            <strong>~25 ns</strong>
            <em>25 seconds</em>
          </div>
          <div class="latency-row">
            <span>CA -&gt; Netherlands -&gt; CA</span>
            <strong>~150,000,000 ns</strong>
            <em>5 years</em>
          </div>
        </div>
        <div class="desk-tags"><span>Systems</span><span>Latency</span><span>Scale</span></div>
      </aside>
    </section>

    <section class="signal-strip" aria-label="Current status">
      <div class="wrap signal-inner">
        <p><span class="signal-label">NOW</span> Exploring how visual notes improve technical understanding.</p>
        <p class="signal-meta">Singapore &middot; 1&deg;17'N</p>
      </div>
    </section>

    <section class="wrap section-grid">
      <div>
        <p class="eyebrow">Across every collection</p>
        <h2>Recent thinking</h2>
      </div>
      <div class="feature-list">
        {recentItems.map((item, index) => <a class="feature-row" href={item.href}>
          <span class="feature-num">{String(index + 1).padStart(2, '0')}</span>
          <span><strong>{item.title}</strong><small>{item.category} &middot; {formatDate(item.publishedAt)}</small></span>
          <span class="arrow">&rarr;</span>
        </a>)}
        {recentItems.length === 0 && <p>No articles have been published yet.</p>}
      </div>
    </section>
  </main>
</BaseLayout>
