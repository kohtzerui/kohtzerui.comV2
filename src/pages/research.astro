---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CollectionCard from '../components/CollectionCard.astro';

const entries = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<BaseLayout title="Research" description="Ongoing questions, experiments, and reading trails by Koh Tze Rui." current="research">
  <main>
    <header class="page-head wrap reveal">
      <p class="eyebrow">Index / {String(entries.length).padStart(2, '0')} articles</p>
      <h1>What I'm<br /><em>looking into.</em></h1>
      <p>Published research questions, experiments, and reading trails will appear here, ordered from newest to oldest.</p>
      {tags.length > 0 && <div class="filter-row"><button class="filter-button active" data-filter="all">All research</button>{tags.map((tag) => <button class="filter-button" data-filter={slugify(tag)}>{tag}</button>)}</div>}
    </header>

    <section class="post-grid editorial-grid wrap" aria-label="Research articles">
      {entries.length === 0 && <div class="collection-empty"><span class="eyebrow">Nothing published yet</span><h2>Research notes are being prepared.</h2><p>Questions and findings will appear here when they are ready to share.</p></div>}
      {entries.map((entry, index) => {
        const date = entry.data.publishedAt.toISOString().slice(0, 10);
        const displayDate = entry.data.publishedAt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        const category = entry.data.tags.map(slugify).join('|');
        return <CollectionCard
          href={`/research/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
          tags={entry.data.tags}
          dateLabel={displayDate}
          dateTime={date}
          badge={entry.data.stage}
          action="Read research"
          cover={entry.data.cover}
          coverAlt={`${entry.data.title} research cover`}
          latest={index === 0}
          category={category}
          dataDate={date}
        />;
      })}
    </section>
  </main>
</BaseLayout>
